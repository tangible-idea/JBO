TYPESAFE_API_KEY=your_typesafe_api_key
PORT=8787
# 모바일 앱을 같은 Wi-Fi에서 연결할 때만 활성화하세요.
# HOST=0.0.0.0
# MOBILE_TOKEN=여기에_openssl_rand_hex_24_결과를_입력
# MOBILE_CHROME_ROOT=/Users/you/Library/Application Support/Google/Chrome
# MOBILE_DOWNLOADS_ROOT=/Users/you/Downloads
# MOBILE_TIDY_ROOT=/Users/you/Documents/Tidymark
# Optional: override the SDK's default model.
# TYPESAFE_MODEL=jev-1.13

# Optional: Poe API for the bookmark interest report (https://poe.com/api_key).
POE_API_KEY=
# POE_MODEL=Claude-Sonnet-4.6

# Chrome Web Store 배포 (docs/release-playbook.md 참고)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# CWS_PUBLISHER_ID=3b3bdeb2-dba1-4488-b44d-72afecefc090
# CWS_ITEM_ID=nglhhhkgognkifklfokjakljcopimcjg

# Cloud Run 배포 (make deploy-api)
GCP_PROJECT=
GCP_REGION=asia-northeast3
